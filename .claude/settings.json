{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(uv run ruff *)",
      "Bash(uv run pytest *)",
      "Bash(npm --prefix ui ci)",
      "Bash(npm --prefix ui run check)",
      "Bash(npm --prefix ui run build)"
    ],
    "ask": [
      "Bash(*core.hooksPath*)",
      "Bash(*core.hookspath*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git -C * push *)",
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -C * commit -n*)",
      "Bash(git -C * commit * -n*)",
      "Read(~/.config/agentfly/**)"
    ]
  }
}
