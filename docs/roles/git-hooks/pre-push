#!/bin/sh
# AgentFly: refuse every push unless the owner sets AGENTFLY_ALLOW_PUSH=1.
# A guard against accidents, not a lock: `git push --no-verify` skips it, and
# anyone can set the variable. The stronger layer is the "Bash(git push:*)"
# deny rule in .claude/settings.json (Claude Code sessions only).
if [ "${AGENTFLY_ALLOW_PUSH:-}" = "1" ]; then
  exit 0
fi
echo "pre-push: pushing is off in this repo. Workers and the lead never push;" >&2
echo "the owner pushes with AGENTFLY_ALLOW_PUSH=1 git push ..." >&2
exit 1
