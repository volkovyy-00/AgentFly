{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": ".venv/bin/python hooks/hook.py", "timeout": 1 }
    ],
    "beforeReadFile": [
      { "command": ".venv/bin/python hooks/hook.py", "timeout": 1 }
    ],
    "beforeMCPExecution": [
      { "command": ".venv/bin/python hooks/hook.py", "timeout": 1 }
    ],
    "afterFileEdit": [
      { "command": ".venv/bin/python hooks/hook.py", "timeout": 1 }
    ],
    "preToolUse": [
      { "command": ".venv/bin/python hooks/hook.py", "timeout": 1 }
    ]
  }
}
