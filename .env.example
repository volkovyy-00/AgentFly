# real values live in ~/.config/agentfly/neo4j.env, never here.
# Neo4j stays OFF until ~/.config/agentfly/config.toml says `neo4j = true`;
# this file alone does not turn it on. Session history is kept locally in
# ~/.local/share/agentfly/history.db either way (`agentfly wipe` deletes it).
#
# Aura URI: prefer neo4j+s:// from the console. On machines where system CAs
# fail TLS verify (seen as ServiceUnavailable / SSLCertVerificationError),
# use neo4j+ssc://host instead (demo OK; not for production trust).
NEO4J_URI=neo4j+ssc://YOUR.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# Command cleaning before storage (SPEC §4). Default on. Set 0/false/off to
# store raw commands (can put secrets in the DB later — only for debugging).
CLEAN_COMMANDS=1
